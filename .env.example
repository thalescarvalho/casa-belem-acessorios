# =============================================================================
# Casa Belém Acessórios — variáveis de ambiente
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA commite o arquivo ".env" (já está no .gitignore).
# =============================================================================

# --- Frontend (Vite) — expostas ao browser, use somente chaves PÚBLICAS aqui ---

# URL e chave anônima do seu projeto Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Ambiente da aplicação: development | staging | production
VITE_APP_ENV=development

# URL pública do site (usada em SEO: canonical, sitemap, Open Graph)
VITE_SITE_URL=http://localhost:5173

# Public key do Mercado Pago (SDK de checkout no frontend). Use a chave de
# TESTE (TEST-...) em desenvolvimento e a de PRODUÇÃO (APP_USR-...) apenas
# no ambiente de produção. Nunca misture as duas.
VITE_MERCADOPAGO_PUBLIC_KEY=

# =============================================================================
# --- Backend (Supabase Edge Functions) ---
# Estas NÃO vão no .env do frontend. Configure-as como secrets do projeto
# Supabase, nunca no bundle do Vite:
#
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#   supabase secrets set MERCADOPAGO_ACCESS_TOKEN=...
#   supabase secrets set MERCADOPAGO_WEBHOOK_SECRET=...
#   supabase secrets set MELHORENVIO_ACCESS_TOKEN=...
#   supabase secrets set MELHORENVIO_SANDBOX=true
#
# SUPABASE_SERVICE_ROLE_KEY   -> chave service_role (Project Settings -> API).
#                                 Nunca exponha no frontend.
# MERCADOPAGO_ACCESS_TOKEN    -> Access Token do Mercado Pago (TEST-... em
#                                 sandbox, APP_USR-... em produção).
# MERCADOPAGO_WEBHOOK_SECRET  -> chave de assinatura do webhook (Mercado Pago
#                                 -> Notificações -> Assinatura secreta),
#                                 usada para validar a autenticidade do webhook.
# MELHORENVIO_ACCESS_TOKEN    -> token OAuth do Melhor Envio (painel
#                                 sandbox.melhorenvio.com.br em teste, depois
#                                 melhorenvio.com.br em produção).
# MELHORENVIO_SANDBOX         -> "true" (padrão) usa a API de sandbox; troque
#                                 para "false" junto com o token de produção.
# =============================================================================
